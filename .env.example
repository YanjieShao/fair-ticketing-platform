# Local overrides. Copy this file to `.env` and keep `.env` out of git.
# Spring Boot does not load `.env` by itself; export the variables, or
# prefix the run command: `export $(grep -v '^#' .env | xargs) && ./mvnw spring-boot:run`

# Required in any shared or public environment. Must be at least 32 bytes.
FT_JWT_SECRET=replace-me-with-at-least-32-random-bytes

# DB_PESSIMISTIC_LOCK | DB_CONDITIONAL_UPDATE | REDIS_LUA
FT_INVENTORY_STRATEGY=DB_PESSIMISTIC_LOCK

FT_SEED_ENABLED=false
FT_WAITING_ROOM_ENABLED=false
FT_PAYMENT_FAILURE_RATE=0.0

# Browser origins allowed to call the API directly. The Vite dev server
# proxies /api, so this is only needed if the UI talks to :8080 itself.
FT_CORS_ORIGINS=http://localhost:5173

FT_ML_BASE_URL=http://localhost:8090
FT_FORECAST_ON_START=false
